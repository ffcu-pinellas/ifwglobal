# ----------------------------------------------------------------------
# IFW Global - Hostinger Apache & LiteSpeed Optimized Configuration
# ----------------------------------------------------------------------

# Ensure symbolic links are followed and directory browsing is disabled
Options +FollowSymLinks -Indexes

DirectoryIndex index.php index.html

# Disable LiteSpeed Rate Limiting / Throttling to prevent 429 errors
<IfModule litespeed>
    RewriteEngine On
    RewriteRule .* - [E=nothrottle:1]
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect legacy consultation URL
    RewriteRule ^book-a-consultation(?:/.*|\.php)?$ /contact/ [R=301,L]

    # About aliases
    RewriteRule ^about/?$ /about-us.php [L]

    # 1. Allow direct access to real existing files or directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 2. Fallback for public asset files
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
    RewriteRule ^(.*)$ public/$1 [L]

    # 3. Allow extensionless URLs for root pages (e.g. /about-us or /about-us/ -> /about-us.php)
    RewriteCond %{DOCUMENT_ROOT}/$1.php -f
    RewriteRule ^([^/]+)/?$ $1.php [L]

    # 4. Allow extensionless URLs for subdirectories (e.g. /admin/settings -> /admin/settings.php)
    RewriteCond %{DOCUMENT_ROOT}/$1/$2.php -f
    RewriteRule ^([^/]+)/([^/]+)/?$ $1/$2.php [L]
</IfModule>

# Grant full access to web resources and scripts
<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|html|css|js|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|eot|pdf|json)$">
        Require all granted
    </FilesMatch>
</IfModule>
