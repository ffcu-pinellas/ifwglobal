<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1. Direct access to existing files or directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. Fallback for public asset files
RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
RewriteRule ^(.*)$ public/$1 [L]

# 3. Allow extensionless URLs (e.g. /about -> /about.php)
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)$ $1.php [L]

Options -Indexes
</IfModule>

RewriteRule ^book-a-consultation\.php$ /book-a-consultation/ [R=301,L]

