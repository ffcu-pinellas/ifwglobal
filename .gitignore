# Ignore large media files that cause Git HTTP timeouts
*.mp4
*.mov
*.avi
*.wmv
*.mkv

# Ignore node modules and environment secrets
node_modules/
.env
.env.*
!.env.example

# Ignore database dumps, runtime uploads, backups, and helper scripts
*.sql
*.ps1
*.out
uploads/
public/uploads/
admin/backups/
